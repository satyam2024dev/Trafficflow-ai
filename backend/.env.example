# Copy to .env (repo root) and fill in. Never commit .env.
POSTGRES_USER=trafficflow
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trafficflow
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/db   # optional full override

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIDEO_DIR=videos
APP_TIMEZONE=UTC            # e.g. Asia/Kolkata, Europe/London - used for "today" and hourly buckets

# --- AI ---
YOLO_MODEL=ai/models/yolo11n.pt
YOLO_VEHICLE_CLASSES=2:car,3:motorcycle,5:bus,7:truck
CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=cpu             # cpu | 0 (first GPU)
YOLO_IMGSZ=640
TRACKER=bytetrack           # bytetrack | botsort
PROCESS_WIDTH=960
FRAME_SKIP=2                # run AI on every 2nd frame (raise to go faster on weak CPUs)
REALTIME_PLAYBACK=true
LOOP_VIDEO=false
